#!/bin/sh
# Block pushes whose commits carry personal/location data in files or messages.
root="$(git rev-parse --show-toplevel)"
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  python3 "$root/tools/hooks/pii_check.py" push "$local_sha" "$remote_sha" || exit 1
done
# Belt and braces: an extra scanner over the tracked tree, if configured locally
# (git config hqpweb.preflight /path/to/scanner.py). Not set in a fresh clone.
scanner="$(git config --get hqpweb.preflight || true)"
if [ -n "$scanner" ] && [ -f "$scanner" ]; then
  python3 "$scanner" $(git ls-files) >/dev/null || { echo "BLOCKED by preflight-public.py"; exit 1; }
fi
